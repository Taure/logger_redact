{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    covertool,
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git",
            {ref, "a2d37609afb43e371e074d3e0b64d3baec67398e"}}}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{covertool, [{coverdata_files, ["ct.coverdata"]}]}.

{ex_doc, [
    {source_url, "https://github.com/Taure/logger_redact"},
    {extras, ["README.md", "guides/configuration.md"]},
    {main, "README.md"}
]}.

{erlfmt, [write]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns, unknown]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]},
    {bench, [
        {extra_src_dirs, [{"bench", [{recursive, false}]}]}
    ]}
]}.
